# DSP runtime configuration.
#
# Copy to `.env` and adjust. Every variable below is read by
# apps/server/src/env.ts. Never put a real secret in a committed file.

# --- network ---------------------------------------------------------------

# Interface to bind. Defaults to 127.0.0.1, which is the right default: DSP 0.1
# serves plain HTTP. Use 0.0.0.0 only behind a TLS terminator.
DSP_HOST=127.0.0.1

# Port to listen on. Defaults to 4040. Must be a positive integer.
DSP_PORT=4040

# --- authentication --------------------------------------------------------

# Bearer token required on every endpoint except /health, /.well-known/dsp and
# /openapi.json. If unset, the server generates a random token for that process
# only and prints it to stdout — convenient locally, useless in a container.
# Generate one with: openssl rand -base64 32
DSP_AUTH_TOKEN=

# --- identity and policy scope --------------------------------------------

# Deployment environment. Feeds the risk score (production +20, staging +8) and
# policy scoping. This is the ONLY source of environment: a Desired State document
# cannot declare its own, or it could choose weaker policy. Defaults to `local`.
DSP_ENVIRONMENT=local

# Isolation scope for idempotency keys, which are unique per
# tenant + planId + idempotencyKey. Single-tenant in 0.1. Defaults to `local`.
DSP_TENANT=local

# Directory of *.yaml / *.yml / *.json policy documents. If unset, the runtime uses
# its built-in bundle: deletions and replacements denied, approval required for
# high and critical risk. A missing directory is an error, not a silent fallback.
# DSP_POLICY_DIR=examples/mock-workspace/policies

# Set to true to let the runtime execute deletions and replacements at all. Even
# then, a request must also ask for them AND the resource type must declare
# `capabilities.delete: true`. Defaults to false. Leave it off in production.
DSP_ALLOW_DESTRUCTIVE=false

# --- storage ---------------------------------------------------------------

# SQLite file holding plans, approvals, operations, idempotency keys and the audit
# chain. Defaults to .dsp/runtime.sqlite. Parent directories are created.
# Back this up: it is the audit trail.
DSP_DATABASE=.dsp/runtime.sqlite

# SQLite file standing in for the mock provider's "external system". Defaults to
# .dsp/mock.sqlite. Not needed once a real provider replaces the mock.
DSP_MOCK_DATABASE=.dsp/mock.sqlite

# --- secrets ---------------------------------------------------------------

# `env` (default) or `encrypted-file`. Any other value is a startup error.
DSP_SECRET_STORE=env

# --- with DSP_SECRET_STORE=env ---
# Secrets come from DSP_SECRET_* variables. A document referencing
# `secretRef: {name: stripe-test}` reads DSP_SECRET_STRIPE_TEST, and
# `{name: stripe-test, key: apiKey}` reads DSP_SECRET_STRIPE_TEST_API_KEY.
# This store is read-only: the runtime never mutates the process environment.
# DSP_SECRET_STRIPE_TEST=

# --- with DSP_SECRET_STORE=encrypted-file ---
# AES-256-GCM store. Both variables are required, or the server refuses to start.
# DSP_SECRET_FILE=.dsp/secrets.json
#
# Either a 32-byte key as base64 or hex, or a passphrase stretched with scrypt.
# Keep it out of the repository and out of the image.
#   openssl rand -base64 32
# DSP_SECRET_MASTER_KEY=

# --- limits ----------------------------------------------------------------

# Maximum Desired State document size in bytes. Default 524288 (512 KiB). Fastify
# rejects an oversized body before it is parsed.
# DSP_MAX_DOCUMENT_BYTES=524288

# How long a plan stays applicable, in seconds. Default 900 (15 minutes). This is
# also the freshness bound on a human approval: re-planning does not extend an open
# window, and an approval from a closed window no longer counts.
# DSP_PLAN_TTL_SECONDS=900

# Timeout for a single provider call, in milliseconds. Default 30000. Exceeding it
# produces a retryable PROVIDER_TIMEOUT.
# DSP_PROVIDER_TIMEOUT_MS=30000

# --- logging ---------------------------------------------------------------

# pino level: trace, debug, info, warn, error, fatal, silent. Default info.
# Logs are redacted: credentials cannot reach them by key name or by value shape.
DSP_LOG_LEVEL=info

# Human-readable log output via pino-pretty. Use locally, not in production.
DSP_LOG_PRETTY=false

# --- CLI -------------------------------------------------------------------
# Read by apps/cli, not by the server.

# Default --server for the CLI.
# DSP_SERVER=http://127.0.0.1:4040

# Default --token for the CLI.
# DSP_TOKEN=
