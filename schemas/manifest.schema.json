{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsp.dev/schemas/v1alpha1/manifest.schema.json",
  "title": "DSP Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "protocolVersion",
    "server",
    "endpoints",
    "features",
    "authentication",
    "limits"
  ],
  "properties": {
    "protocol": {
      "const": "dsp"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceTypes",
        "kinds",
        "inspect",
        "validate",
        "plan",
        "approve",
        "apply",
        "verify",
        "operations",
        "audit"
      ],
      "properties": {
        "resourceTypes": {
          "type": "string"
        },
        "kinds": {
          "type": "string"
        },
        "inspect": {
          "type": "string"
        },
        "validate": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        },
        "approve": {
          "type": "string"
        },
        "apply": {
          "type": "string"
        },
        "verify": {
          "type": "string"
        },
        "operations": {
          "type": "string"
        },
        "audit": {
          "type": "string"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planBeforeApply",
        "signedPlans",
        "idempotency",
        "verification",
        "auditLog",
        "policyEvaluation",
        "destructiveChanges",
        "driftDetection"
      ],
      "properties": {
        "planBeforeApply": {
          "type": "boolean"
        },
        "signedPlans": {
          "type": "boolean"
        },
        "idempotency": {
          "type": "boolean"
        },
        "verification": {
          "type": "boolean"
        },
        "auditLog": {
          "type": "boolean"
        },
        "policyEvaluation": {
          "type": "boolean"
        },
        "destructiveChanges": {
          "type": "boolean"
        },
        "driftDetection": {
          "type": "boolean"
        }
      }
    },
    "authentication": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDocumentBytes",
        "maxDocumentDepth",
        "maxResources",
        "maxChanges",
        "planTtlSeconds"
      ],
      "properties": {
        "maxDocumentBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxDocumentDepth": {
          "type": "integer",
          "minimum": 1
        },
        "maxResources": {
          "type": "integer",
          "minimum": 1
        },
        "maxChanges": {
          "type": "integer",
          "minimum": 1
        },
        "planTtlSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
